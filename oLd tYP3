    document.getElementById('btn-toggle-sound').addEventListener('click', () => {
      state.soundEnabled = !state.soundEnabled;
      soundEngine.enabled = state.soundEnabled;
      if (state.soundEnabled) soundEngine.playKeyStrike();
      saveState();
      renderCurrentNote();
      showToast(state.soundEnabled ? 'Mechanical sound ON' : 'Mechanical sound MUTED');
    });

    document.getElementById('btn-new-note').addEventListener('click', () => {
      const fresh = createDefaultNote();
      state.notes.unshift(fresh);
      state.currentNoteId = fresh.id;
      saveState();
      triggerPaperRollAnimation();
      renderCurrentNote();
      soundEngine.playCarriageReturn();
      showToast('Fresh sheet loaded into platen', '📄');
      editor.focus();
    });

    document.getElementById('btn-first-line').addEventListener('click', () => {
      const line = FIRST_LINES[Math.floor(Math.random() * FIRST_LINES.length)];
      const note = getCurrentNote();
      if (!note) return;
      note.content = note.content ? `${note.content}\n\n${line}` : line;
      saveState();
      renderCurrentNote();
      soundEngine.playKeyStrike();
      showToast('First line prompt added', '✨');
      editor.focus();
    });

    // Photo Stamp Upload
    document.getElementById('photo-upload-input').addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = (ev) => {
        const note = getCurrentNote();
        if (note) {
          note.photoStamp = ev.target.result;
          if (!note.photoWidth) note.photoWidth = 148;
          saveState();
          renderCurrentNote();
        }
        showToast('Memory sticker attached — drag or resize freely', '📷');
      };
      reader.readAsDataURL(file);
      e.target.value = '';
    });

    document.getElementById('btn-remove-photo').addEventListener('click', () => {
      const note = getCurrentNote();
      if (note) {
        note.photoStamp = '';
        note.photoX = null;
        note.photoY = null;
        note.photoWidth = 148;
        saveState();
        renderCurrentNote();
      }
      showToast('Photo stamp removed');
    });

    photoLabelInput.addEventListener('input', () => {
      const note = getCurrentNote();
      if (note) {
        note.photoLabel = photoLabelInput.value;
        saveState();
      }
    });

    // Draggable & Resizable Sticker Stamp Interactions (Mouse + Touch)
    (function initPhotoStickerInteractions() {
      const resizeHandle = document.getElementById('photo-stamp-resize');
      let mode = null; // 'drag' | 'resize'
      let startX = 0, startY = 0;
      let startLeft = 0, startTop = 0, startWidth = 148;

      function getClientXY(e) {
        if (e.touches && e.touches.length) {
          return { x: e.touches[0].clientX, y: e.touches[0].clientY };
        }
        return { x: e.clientX, y: e.clientY };
      }

      function onStart(e, interactionMode) {
        if (e.target === photoLabelInput || e.target.id === 'btn-remove-photo') return;
        e.preventDefault();
        mode = interactionMode;
        const pt = getClientXY(e);
        startX = pt.x;
        startY = pt.y;

        const paperRect = paperSheet.getBoundingClientRect();
        const stampRect = photoContainer.getBoundingClientRect();
        startLeft = stampRect.left - paperRect.left;
        startTop = stampRect.top - paperRect.top;
        startWidth = stampRect.width;

        photoContainer.style.left = `${startLeft}px`;
        photoContainer.style.top = `${startTop}px`;
        photoContainer.style.right = 'auto';
      }

      function onMove(e) {
        if (!mode) return;
        const pt = getClientXY(e);
        const dx = pt.x - startX;
        const dy = pt.y - startY;
        const paperRect = paperSheet.getBoundingClientRect();

        if (mode === 'drag') {
          const maxLeft = Math.max(0, paperRect.width - photoContainer.offsetWidth);
          const maxTop = Math.max(0, paperRect.height - photoContainer.offsetHeight);
          const nextLeft = Math.min(maxLeft, Math.max(0, startLeft + dx));
          const nextTop = Math.min(maxTop, Math.max(0, startTop + dy));
          photoContainer.style.left = `${nextLeft}px`;
          photoContainer.style.top = `${nextTop}px`;
        } else if (mode === 'resize') {
          const maxAllowedWidth = Math.min(340, paperRect.width - startLeft - 12);
          const nextWidth = Math.min(Math.max(96, startWidth + dx), Math.max(96, maxAllowedWidth));
          photoContainer.style.width = `${nextWidth}px`;
        }
      }

      function onEnd() {
        if (!mode) return;
        const note = getCurrentNote();
        if (note) {
          note.photoX = parseFloat(photoContainer.style.left) || 0;
          note.photoY = parseFloat(photoContainer.style.top) || 0;
          note.photoWidth = parseFloat(photoContainer.style.width) || 148;
          saveState();
        }
        mode = null;
      }

      photoContainer.addEventListener('mousedown', (e) => onStart(e, 'drag'));
      photoContainer.addEventListener('touchstart', (e) => onStart(e, 'drag'), { passive: false });

      resizeHandle.addEventListener('mousedown', (e) => {
        e.stopPropagation();
        onStart(e, 'resize');
      });
      resizeHandle.addEventListener('touchstart', (e) => {
        e.stopPropagation();
        onStart(e, 'resize');
      }, { passive: false });

      window.addEventListener('mousemove', onMove);
      window.addEventListener('touchmove', onMove, { passive: false });
      window.addEventListener('mouseup', onEnd);
      window.addEventListener('touchend', onEnd);
    })();

    // --- 10. THE BOX (ARCHIVE MODAL) ---
    const modalBox = document.getElementById('modal-box');
    const boxNotesList = document.getElementById('box-notes-list');

    function renderBoxModal() {
      const filtered = state.boxFilter === 'All'
        ? state.notes
        : state.notes.filter(n => n.divider === state.boxFilter);
      if (!filtered.length) {
        boxNotesList.innerHTML = `<div class="col-span-full text-center py-10 text-stone-400 text-sm">No sheets filed under "${state.boxFilter}".</div>`;
        return;
      }
      boxNotesList.innerHTML = filtered.map((n, idx) => {
        const isCurrent = n.id === state.currentNoteId;
        const preview = n.content.trim() || '(Blank sheet)';
        const flowerSvg = (PRESSED_FLOWERS[n.flower] || PRESSED_FLOWERS.none).svg;
        return `
          <div style="animation-delay: ${idx * 45}ms" onclick="selectNoteFromBox('${n.id}')" class="drawer-item-anim cursor-pointer p-4 rounded-xl border transition-all duration-200 hover:-translate-y-1 hover:shadow-md flex flex-col justify-between gap-3 ${isCurrent ? 'bg-amber-50/80 border-amber-700 shadow-sm' : 'bg-white border-stone-200 hover:border-stone-400'}">
            <div>
              <div class="flex items-center justify-between text-[10px] font-mono text-stone-400 mb-1.5">
                <span>${n.date} • ${n.divider.toUpperCase()}</span>
                <div class="scale-75 origin-right">${n.flower !== 'none' ? flowerSvg : ''}</div>
              </div>
              <p class="font-typewriter-vintage text-xs text-stone-800 line-clamp-3 leading-relaxed">${preview.replace(/</g, '&lt;')}</p>
            </div>
            <div class="flex items-center justify-between pt-2 border-t border-stone-100 text-[11px]">
              <span class="text-stone-400">${n.content.length} chars</span>
              ${state.notes.length > 1 ? `<button onclick="event.stopPropagation(); deleteNoteFromBox('${n.id}')" class="text-rose-700 hover:underline">Discard</button>` : '<span class="text-amber-800 font-medium">Active</span>'}
            </div>
          </div>
        `;
      }).join('');
    }

    window.selectNoteFromBox = function(id) {
      state.currentNoteId = id;
      saveState();
      triggerPaperRollAnimation();
      renderCurrentNote();
      modalBox.classList.add('hidden');
      modalBox.classList.remove('flex');
      soundEngine.playCarriageReturn();
    };

    window.deleteNoteFromBox = function(id) {
      if (state.notes.length <= 1) return;
      state.notes = state.notes.filter(n => n.id !== id);
      if (state.currentNoteId === id) {
        state.currentNoteId = state.notes[0].id;
      }
      saveState();
      renderCurrentNote();
      renderBoxModal();
      showToast('Sheet discarded from The Box');
    };

    document.getElementById('btn-open-box').addEventListener('click', () => {
      renderBoxModal();
      modalBox.classList.remove('hidden');
      modalBox.classList.add('flex');
    });

    document.getElementById('btn-close-box').addEventListener('click', () => {
      modalBox.classList.add('hidden');
      modalBox.classList.remove('flex');
    });

    document.querySelectorAll('.box-filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        state.boxFilter = btn.dataset.filter;
        document.querySelectorAll('.box-filter-btn').forEach(b => {
          b.className = b.dataset.filter === state.boxFilter
            ? 'box-filter-btn px-3 py-1 rounded-full bg-stone-800 text-white font-medium'
            : 'box-filter-btn px-3 py-1 rounded-full bg-white text-stone-700 border border-stone-300 hover:bg-stone-50';
        });
        renderBoxModal();
      });
    });

    // --- 11. EXPORT & SHARE MODAL ---
    const modalExport = document.getElementById('modal-export');
    let selectedExportRatio = 'auto';

    document.querySelectorAll('.export-ratio-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        selectedExportRatio = btn.dataset.ratio;
        document.querySelectorAll('.export-ratio-btn').forEach(b => {
          b.className = b.dataset.ratio === selectedExportRatio
            ? 'export-ratio-btn px-2.5 py-1 rounded-lg bg-stone-800 text-amber-50 font-medium transition-all active:scale-95'
            : 'export-ratio-btn px-2.5 py-1 rounded-lg bg-stone-100 text-stone-700 hover:bg-stone-200/80 font-medium transition-all active:scale-95';

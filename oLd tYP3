    window.updateNoteProp = function(prop, value) {
      const note = getCurrentNote();
      if (!note) return;
      note[prop] = value;
      saveState();
      renderCurrentNote();
    };

    window.adjustFontSize = function(delta) {
      const note = getCurrentNote();
      if (!note) return;
      const current = note.fontSize || 17;
      const next = Math.min(30, Math.max(12, current + delta));
      if (next !== current) {
        updateNoteProp('fontSize', next);
        soundEngine.playKeyStrike();
      }
    };

    // --- 9. EVENT LISTENERS ---
    editor.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        soundEngine.playCarriageReturn();
        triggerCharmSwing();
      } else if (e.key === ' ') {
        soundEngine.playSpacebar();
      } else if (e.key.length === 1 || e.key === 'Backspace') {
        soundEngine.playKeyStrike();
        triggerCharmSwing();
      }
    });

    editor.addEventListener('input', () => {
      const note = getCurrentNote();
      if (note) {
        note.content = editor.value;
        saveState();
      }
      autoResizeEditor();
      updateCharacterCount();
      updateCarriagePosition();
    });

    window.addEventListener('resize', autoResizeEditor);

    editor.addEventListener('click', updateCarriagePosition);
    editor.addEventListener('keyup', updateCarriagePosition);

    // Capsule tap hides/shows rail cleanly
    capsule.addEventListener('click', () => {
      triggerCharmSwing();
      soundEngine.playCarriageReturn();
      showToast('Carriage reset');
    });

    // Cycle pressed flower on direct click
    flowerSlot.addEventListener('click', () => {
      const note = getCurrentNote();
      const keys = Object.keys(PRESSED_FLOWERS);
      const next = keys[(keys.indexOf(note.flower) + 1) % keys.length];
      updateNoteProp('flower', next);
    });

    // Bottom Drawer Tabs
    document.querySelectorAll('.drawer-tab').forEach(btn => {

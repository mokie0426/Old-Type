        `).join('');

        html += `
          <select style="animation-delay: 180ms" onchange="updateNoteProp('charm', this.value)" class="drawer-item-anim px-2.5 py-1.5 rounded-lg border border-stone-300/80 bg-white/90 text-stone-700 outline-none transition-all duration-200 hover:-translate-y-0.5" title="Rail Charm">
            ${CHARMS.map(c => `<option value="${c.id}" ${note.charm === c.id ? 'selected' : ''}>${c.emoji || '∅'} ${c.name}</option>`).join('')}

      },
      sakura: {
        label: 'Blossom',
        svg: `<svg width="28" height="28" viewBox="0 0 36 36" fill="none"><path d="M18 33C19 26 18 20 18 16" stroke="#6d5c54" stroke-width="1.4" stroke-linecap="round"/><circle cx="18" cy="10" r="4" fill="#f4b8c4"/><circle cx="23" cy="14" r="4" fill="#f7cad3"/><circle cx="21" cy="20" r="4" fill="#f4b8c4"/><circle cx="15" cy="20" r="4" fill="#f7cad3"/><circle cx="13" cy="14" r="4" fill="#f4b8c4"/><circle cx="18" cy="15" r="2.2" fill="#b84a62"/></svg>`
      },
      fern: {
        label: 'Sage Fern',
        svg: `<svg width="28" height="28" viewBox="0 0 36 36" fill="none"><path d="M18 33C17 24 18 14 20 6" stroke="#4c6444" stroke-width="1.4" stroke-linecap="round"/><path d="M18 26L12 23M18 22L11 18M18 18L12 13M19 13L14 9M18 25L24 22M18 20L25 16M19 15L24 11" stroke="#68855c" stroke-width="2.2" stroke-linecap="round"/></svg>`
      },
      forgetmenot: {
        label: 'Bluebell',
        svg: `<svg width="28" height="28" viewBox="0 0 36 36" fill="none"><path d="M18 33L18 16" stroke="#5c6b4d" stroke-width="1.4" stroke-linecap="round"/><circle cx="18" cy="10" r="3.8" fill="#6b9ac4"/><circle cx="22.5" cy="14" r="3.8" fill="#7aa8d1"/><circle cx="13.5" cy="14" r="3.8" fill="#7aa8d1"/><circle cx="18" cy="17.5" r="3.8" fill="#6b9ac4"/><circle cx="18" cy="13.8" r="2" fill="#f2d06b"/></svg>`
      }
    };

    const CHARMS = [
      { id: 'key', emoji: '🗝️', name: 'Brass Key' },
      { id: 'moon', emoji: '🌙', name: 'Crescent' },
      { id: 'feather', emoji: '🪶', name: 'Quill' },
      { id: 'cat', emoji: '🐈‍⬛', name: 'Black Cat' },
      { id: 'clover', emoji: '🍀', name: 'Clover' },
      { id: 'none', emoji: '', name: 'None' }
    ];

    // --- 4. APPLICATION STATE ---
    let state = {
      notes: [],
      currentNoteId: null,
      activeDrawer: 'paper',
      boxFilter: 'All',
      soundEnabled: true,
      showRail: true
    };

    function createDefaultNote() {
      return {
        id: 'note_' + Date.now(),
        content: '',
        date: new Date().toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }).toUpperCase(),
        divider: 'Journal',
        paper: 'paper-cream',
        curved: true,
        letterhead: 'FROM THE DESK OF oLd tYP3',
        font: 'font-typewriter-vintage',
        fontSize: 17,
        textAlign: 'left',
        inkColor: 'ink-black',
        inkWear: 'wear-fresh',
        flower: 'marigold',
        charm: 'key',
        waxSeal: false,
        photoStamp: '',
        photoLabel: 'Memory Stamp',
        photoX: null,
        photoY: null,
        photoWidth: 148
      };
    }

    // --- 5. DOM REFERENCES ---
    const editor = document.getElementById('typewriter-editor');
    const paperSheet = document.getElementById('paper-sheet');
    const capsule = document.getElementById('typewriter-capsule');
    const capsuleCol = document.getElementById('capsule-col-indicator');
    const hangingCharm = document.getElementById('hanging-charm');
    const typebarStriker = document.getElementById('typebar-striker');
    const spoolLeft = document.getElementById('spool-left');
    const spoolRight = document.getElementById('spool-right');
    const waxSealSlot = document.getElementById('wax-seal-slot');
    const flowerSlot = document.getElementById('pressed-flower-slot');
    const letterheadDisplay = document.getElementById('letterhead-display');
    const dateDisplay = document.getElementById('note-date-display');
    const dividerDisplay = document.getElementById('note-divider-display');
    const charCounter = document.getElementById('char-counter');
    const charProgress = document.getElementById('char-progress');
    const drawerContent = document.getElementById('drawer-content');
    const photoContainer = document.getElementById('photo-stamp-container');
    const photoImg = document.getElementById('photo-stamp-img');
    const photoLabelInput = document.getElementById('photo-stamp-label');
    let spoolAngle = 0;

    // --- 6. PERSISTENCE & INITIALIZATION ---
    function loadState() {
      try {
        const saved = localStorage.getItem('platen_web_state_v1');
        if (saved) {
          const parsed = JSON.parse(saved);
          state.notes = parsed.notes || [];
          state.currentNoteId = parsed.currentNoteId || null;
          state.soundEnabled = parsed.soundEnabled !== undefined ? parsed.soundEnabled : true;
        }
      } catch (e) {
        console.warn('Could not load saved state:', e);
      }

      if (!state.notes.length) {
        const welcomeNote = createDefaultNote();
        welcomeNote.content = "Welcome to oLd tYP3.\n\nStrike the keys to hear the mechanical hammers, switch ink ribbons below, or decorate your page with pressed flowers and wax seals.";
        state.notes.push(welcomeNote);
        state.currentNoteId = welcomeNote.id;
      }

      if (!state.notes.find(n => n.id === state.currentNoteId)) {
        state.currentNoteId = state.notes[0].id;
      }

      soundEngine.enabled = state.soundEnabled;
    }

    function saveState() {
      try {
        localStorage.setItem('platen_web_state_v1', JSON.stringify({
          notes: state.notes,
          currentNoteId: state.currentNoteId,
          soundEnabled: state.soundEnabled
        }));
        document.getElementById('box-count-badge').textContent = state.notes.length;
      } catch (e) {
        console.warn('Could not save state:', e);
      }
    }

    function getCurrentNote() {
      return state.notes.find(n => n.id === state.currentNoteId);
    }

    // --- 7. RENDERING CURRENT NOTE & CUSTOMIZATIONS ---
    function triggerPaperRollAnimation() {
      paperSheet.classList.remove('paper-rolling');
      void paperSheet.offsetWidth;
      paperSheet.classList.add('paper-rolling');
    }

    function renderCurrentNote() {
      const note = getCurrentNote();
      if (!note) return;

      paperSheet.className = `relative w-full max-w-2xl min-h-[58vh] sm:min-h-[64vh] px-6 sm:px-14 py-10 sm:py-14 transition-all duration-500 flex flex-col justify-between border border-stone-300/60 overflow-hidden ${note.paper} ${note.curved ? 'paper-curved' : 'rounded-md'}`;

      const fontSize = note.fontSize || 17;
      const textAlign = note.textAlign || 'left';
      const alignClass = {
        left: 'text-left',
        center: 'text-center',
        right: 'text-right',
        justify: 'text-justify'
      }[textAlign] || 'text-left';

      editor.value = note.content;
      editor.style.fontSize = `${fontSize}px`;
      editor.style.lineHeight = `${Math.round(fontSize * 1.85)}px`;
      editor.className = `relative z-10 w-full bg-transparent resize-none overflow-hidden break-words whitespace-pre-wrap border-none outline-none tracking-wide placeholder:text-stone-400/60 transition-colors duration-300 ${note.font} ${note.inkColor} ${note.inkWear} ${alignClass}`;

      autoResizeEditor();

      letterheadDisplay.textContent = note.letterhead || '';
      letterheadDisplay.style.display = note.letterhead ? 'block' : 'none';
      dateDisplay.textContent = note.date;
      dividerDisplay.textContent = note.divider;

      const flowerObj = PRESSED_FLOWERS[note.flower] || PRESSED_FLOWERS.none;
      flowerSlot.innerHTML = `<div class="flower-bloom-anim">${flowerObj.svg}</div>`;

      const charmObj = CHARMS.find(c => c.id === note.charm) || CHARMS[0];
      hangingCharm.textContent = charmObj.emoji;

      if (note.waxSeal) {
        waxSealSlot.classList.remove('hidden');
      } else {
        waxSealSlot.classList.add('hidden');
      }

      if (note.photoStamp) {
        photoImg.src = note.photoStamp;
        photoLabelInput.value = note.photoLabel !== undefined ? note.photoLabel : 'Memory Stamp';
        photoContainer.style.width = `${note.photoWidth || 148}px`;
        if (typeof note.photoX === 'number' && typeof note.photoY === 'number') {
          photoContainer.style.left = `${note.photoX}px`;
          photoContainer.style.top = `${note.photoY}px`;
          photoContainer.style.right = 'auto';
        } else {
          photoContainer.style.left = 'auto';
          photoContainer.style.right = '32px';
          photoContainer.style.top = '76px';
        }
        photoContainer.classList.remove('hidden');
      } else {
        photoContainer.classList.add('hidden');
      }

      const iconSound = document.getElementById('icon-sound');
      iconSound.setAttribute('data-lucide', state.soundEnabled ? 'volume-2' : 'volume-x');

      updateCharacterCount();
      updateCarriagePosition();
      renderDrawerControls();
      lucide.createIcons();
    }

    function autoResizeEditor() {
      editor.style.height = 'auto';
      editor.style.height = `${Math.max(300, editor.scrollHeight)}px`;
    }

    function updateCharacterCount() {
      const len = editor.value.length;
      charCounter.textContent = `${len} / 3000`;
      const pct = Math.min(100, (len / 3000) * 100);
      charProgress.style.width = `${pct}%`;
    }

    function updateCarriagePosition() {
      const pos = editor.selectionStart || 0;
      const textBefore = editor.value.substring(0, pos);
      const currentLine = textBefore.split('\n').pop() || '';
      const col = currentLine.length;

      const maxCols = 62;
      const ratio = Math.min(1, col / maxCols);
      const leftPercent = 6 + ratio * 82;
      capsule.style.left = `${leftPercent}%`;
      capsuleCol.textContent = String(col + 1).padStart(3, '0');
    }

    function triggerCharmSwing() {
      hangingCharm.classList.remove('charm-strike');
      void hangingCharm.offsetWidth;
      hangingCharm.classList.add('charm-strike');

      // Animate typebar hammer strike & rotate ribbon spools
      if (typebarStriker) {
        typebarStriker.classList.remove('typebar-active');
        void typebarStriker.offsetWidth;
        typebarStriker.classList.add('typebar-active');
      }
      spoolAngle = (spoolAngle + 28) % 360;
      if (spoolLeft) spoolLeft.style.transform = `rotate(${spoolAngle}deg)`;
      if (spoolRight) spoolRight.style.transform = `rotate(${spoolAngle}deg)`;
    }

    function showToast(msg, icon = '✦') {
      const banner = document.getElementById('toast-banner');
      document.getElementById('toast-message').textContent = msg;
      document.getElementById('toast-icon').textContent = icon;
      banner.classList.remove('opacity-0', 'translate-y-[-10px]');
      banner.classList.add('opacity-100', 'translate-y-0');
      clearTimeout(window._toastTimer);
      window._toastTimer = setTimeout(() => {
        banner.classList.add('opacity-0', 'translate-y-[-10px]');
        banner.classList.remove('opacity-100', 'translate-y-0');
      }, 2200);
    }


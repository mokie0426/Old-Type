      } else if (state.activeDrawer === 'decor') {
        html += Object.entries(PRESSED_FLOWERS).map(([key, val], idx) => `
          <button style="animation-delay: ${idx * 30}ms" onclick="updateNoteProp('flower', '${key}')" class="drawer-item-anim px-2.5 py-1.5 rounded-lg border transition-all duration-200 hover:-translate-y-0.5 active:scale-95 ${note.flower === key ? 'border-amber-700 bg-amber-50/90 font-medium text-stone-900 shadow-sm' : 'border-stone-300/80 bg-white/90 text-stone-700'}">

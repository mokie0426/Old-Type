<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>oLd tYP3</title>
  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Special Elite, Courier Prime, Newsreader, Caveat, and Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@500;600&family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Inter:wght@400;500;600&family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;1,6..72,400&family=Special+Elite&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <!-- html2canvas for Image Export -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js"></script>

  <style>
    :root {
      --desk-bg: #dfd8cc;
      --paper-bg: #fcf9f2;
      --paper-border: #e5dec9;
      --ink-color: #24211e;
      --accent-gold: #b45309;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--desk-bg);
      background-image: 
        radial-gradient(circle at 50% 0%, rgba(255, 255, 255, 0.45), transparent 70%),
        repeating-linear-gradient(90deg, rgba(82, 66, 48, 0.025) 0px, rgba(82, 66, 48, 0.025) 1px, transparent 1px, transparent 12px);
      transition: background-color 0.8s cubic-bezier(0.22, 1, 0.36, 1), color 0.6s ease;
      overflow-x: hidden;
      -webkit-tap-highlight-color: transparent;
    }

    /* Typewriter Fonts */
    .font-typewriter-vintage {
      font-family: 'Special Elite', 'Courier Prime', monospace;
    }
    .font-typewriter-clean {
      font-family: 'Courier Prime', monospace;
    }
    .font-typewriter-serif {
      font-family: 'Newsreader', Georgia, serif;
    }
    .font-vintage-cursive {
      font-family: 'Caveat', cursive;
    }

    /* Enhanced Paper Textures with Micro-Grain & Deckled Depth */
    .paper-cream {
      background-color: #fcf9f2;
      background-image: 
        radial-gradient(rgba(139, 115, 85, 0.07) 1px, transparent 0),
        linear-gradient(180deg, rgba(255,255,255,0.6) 0%, rgba(242,234,218,0.3) 100%);
      background-size: 14px 14px, 100% 100%;
      box-shadow: 
        0 28px 60px -15px rgba(28, 22, 15, 0.24),
        0 10px 24px -6px rgba(28, 22, 15, 0.12),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }
    .paper-cotton {
      background-color: #f5f2eb;
      background-image: 
        linear-gradient(90deg, rgba(0,0,0,0.018) 50%, transparent 50%),
        linear-gradient(rgba(0,0,0,0.018) 50%, transparent 50%),
        radial-gradient(circle at 50% 30%, rgba(255,255,255,0.5), transparent 80%);
      background-size: 3px 3px, 3px 3px, 100% 100%;
      box-shadow: 
        0 28px 60px -15px rgba(28, 22, 15, 0.26),
        0 10px 24px -6px rgba(28, 22, 15, 0.14),
        inset 0 1px 0 rgba(255, 255, 255, 0.85);
    }
    .paper-aged {
      background-color: #efe3ca;
      background-image: 
        radial-gradient(circle at 18% 18%, rgba(168, 125, 62, 0.13), transparent 58%),
        radial-gradient(circle at 82% 85%, rgba(138, 94, 42, 0.15), transparent 55%),
        radial-gradient(rgba(110, 80, 40, 0.06) 1px, transparent 0);
      background-size: 100% 100%, 100% 100%, 12px 12px;
      box-shadow: 
        0 28px 60px -15px rgba(45, 30, 12, 0.3),
        0 10px 24px -6px rgba(45, 30, 12, 0.16),
        inset 0 0 24px rgba(166, 128, 72, 0.12);
    }
    .paper-ruled {
      background-color: #faf8f5;
      background-image: 
        linear-gradient(90deg, transparent 42px, rgba(225, 115, 115, 0.22) 42px, rgba(225, 115, 115, 0.22) 43px, transparent 43px),
        repeating-linear-gradient(transparent, transparent 31px, rgba(130, 155, 185, 0.26) 32px);
      background-position: 0 0, 0 14px;
      box-shadow: 
        0 28px 60px -15px rgba(25, 35, 50, 0.22),
        0 10px 24px -6px rgba(25, 35, 50, 0.1),
        inset 0 1px 0 rgba(255, 255, 255, 0.9);
    }

    /* Curved Paper Effect */
    .paper-curved {
      border-radius: 6px 6px 20px 20px;
      transform: perspective(1400px) rotateX(1.1deg);
    }

    /* Ink Ribbon Colors & Wear Effects */
    .ink-black { color: #1d1b19; }
    .ink-crimson { color: #8c2121; }
    .ink-navy { color: #192e4d; }
    .ink-forest { color: #1e3b29; }

    .wear-fresh {
      text-shadow: 0 0 0.4px currentColor;
      opacity: 0.98;
    }
    .wear-seasoned {
      text-shadow: 0.6px 0.3px 0.8px rgba(0, 0, 0, 0.24), -0.4px 0 0.5px rgba(0, 0, 0, 0.14);
      opacity: 0.91;
    }
    .wear-worn {
      text-shadow: 1.1px 0.6px 1.3px rgba(0, 0, 0, 0.2), -0.8px -0.3px 0.9px rgba(0, 0, 0, 0.15);
      opacity: 0.76;
      filter: contrast(0.92);
    }
    .wear-clean {
      text-shadow: none;
      opacity: 1;
    }

    /* Animated UI Choreography & Tactile Spring Physics */
    @keyframes floatInDown {
      0% { opacity: 0; transform: translateY(-18px) scale(0.97); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes floatInUp {
      0% { opacity: 0; transform: translateY(22px) scale(0.97); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes paperFeedIn {
      0% { opacity: 0; transform: translateY(36px) perspective(1400px) rotateX(4deg) scale(0.96); }
      100% { opacity: 1; transform: translateY(0) perspective(1400px) rotateX(1.1deg) scale(1); }
    }
    @keyframes paperSwapRoll {
      0% { transform: translateY(0) scale(1); opacity: 1; }
      40% { transform: translateY(-28px) scale(0.97); opacity: 0.2; }
      45% { transform: translateY(32px) scale(0.97); opacity: 0; }
      100% { transform: translateY(0) scale(1); opacity: 1; }
    }
    @keyframes pillPopIn {
      0% { opacity: 0; transform: translateY(6px) scale(0.94); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes modalBackdropFade {
      0% { opacity: 0; }
      100% { opacity: 1; }
    }
    @keyframes modalCardSpring {
      0% { opacity: 0; transform: translateY(18px) scale(0.94); }
      100% { opacity: 1; transform: translateY(0) scale(1); }
    }
    @keyframes waxStampPress {
      0% { transform: scale(1.6) rotate(-18deg); opacity: 0; }
      60% { transform: scale(0.92) rotate(4deg); opacity: 1; }
      100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }
    @keyframes flowerBloom {
      0% { transform: scale(0.5) rotate(-25deg); opacity: 0; }
      70% { transform: scale(1.12) rotate(6deg); opacity: 1; }
      100% { transform: scale(1) rotate(0deg); opacity: 1; }
    }
    @keyframes ambientDeskShimmer {
      0%, 100% { background-position: 50% 0%, 0 0; }
      50% { background-position: 52% 4%, 12px 0; }
    }

    body {
      animation: ambientDeskShimmer 14s ease-in-out infinite;
    }

    .anim-header {
      animation: floatInDown 0.65s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .anim-rail {
      animation: floatInDown 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.08s both;
    }
    .anim-paper-entrance {
      animation: paperFeedIn 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.14s both;
    }
    .anim-dock {
      animation: floatInUp 0.75s cubic-bezier(0.22, 1, 0.36, 1) 0.22s both;
    }
    .paper-rolling {
      animation: paperSwapRoll 0.55s cubic-bezier(0.22, 1, 0.36, 1);
    }
    .drawer-item-anim {
      animation: pillPopIn 0.32s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .modal-backdrop-anim {
      animation: modalBackdropFade 0.28s ease-out both;
    }
    .modal-card-anim {
      animation: modalCardSpring 0.38s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .wax-press-anim {
      animation: waxStampPress 0.42s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    .flower-bloom-anim {
      animation: flowerBloom 0.45s cubic-bezier(0.22, 1, 0.36, 1) both;
    }

    /* Frosted Glass & Brass Studio Controls with Spring Hover Lift */
    .studio-pill {
      background: rgba(255, 253, 249, 0.84);
      backdrop-filter: blur(14px);
      -webkit-backdrop-filter: blur(14px);
      border: 1px solid rgba(168, 155, 138, 0.38);
      box-shadow: 0 4px 14px -2px rgba(28, 22, 15, 0.08), inset 0 1px 0 rgba(255, 255, 255, 0.9);
      transition: transform 0.24s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.24s ease, background-color 0.2s ease, border-color 0.2s ease;
    }
    .studio-pill:hover {
      transform: translateY(-2px);
      background: rgba(255, 255, 255, 0.96);
      border-color: rgba(180, 83, 9, 0.35);
      box-shadow: 0 8px 20px -4px rgba(28, 22, 15, 0.14), inset 0 1px 0 rgba(255, 255, 255, 1);
    }
    .studio-pill:active {
      transform: translateY(0) scale(0.95);
    }

    .studio-dock {
      background: rgba(252, 249, 242, 0.88);
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      border: 1px solid rgba(168, 155, 138, 0.4);
      box-shadow: 0 20px 45px -10px rgba(24, 18, 12, 0.16), inset 0 1px 0 rgba(255, 255, 255, 0.95);
      transition: transform 0.3s cubic-bezier(0.22, 1, 0.36, 1), box-shadow 0.3s ease;
    }
    .studio-dock:hover {
      box-shadow: 0 24px 52px -10px rgba(24, 18, 12, 0.2), inset 0 1px 0 rgba(255, 255, 255, 1);
    }

    /* Typewriter Carriage Rail & Capsule Animation */
    @keyframes charmSway {
      0%, 100% { transform: rotate(-4deg); }
      50% { transform: rotate(5deg); }
    }
    .charm-sway {
      transform-origin: top center;
      animation: charmSway 3.2s ease-in-out infinite;
    }
    .charm-strike {
      animation: charmStrike 0.25s ease-out;
    }
    @keyframes charmStrike {
      0% { transform: rotate(0deg) translateY(0); }
      35% { transform: rotate(15deg) translateY(-2px); }
      70% { transform: rotate(-10deg) translateY(0); }
      100% { transform: rotate(0deg) translateY(0); }
    }

    /* Mechanical Typebar Strike Flash */
    @keyframes hammerUp {
      0% { transform: translateY(16px) scaleY(0.4); opacity: 0; }
      40% { transform: translateY(0px) scaleY(1); opacity: 0.95; }
      100% { transform: translateY(14px) scaleY(0.5); opacity: 0; }
    }
    .typebar-active {
      animation: hammerUp 0.14s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    /* Wax Seal Stamp Emboss */
    .wax-seal-badge {
      background: radial-gradient(circle at 32% 30%, #b91c1c, #7f1d1d 68%, #450a0a 100%);
      box-shadow:
        0 6px 14px rgba(69, 10, 10, 0.42),
        inset 0 2px 3px rgba(255, 180, 180, 0.35),
        inset 0 -2px 4px rgba(0, 0, 0, 0.5);
    }

    /* Custom Scrollbar */
    ::-webkit-scrollbar {
      width: 6px;
      height: 6px;
    }
    ::-webkit-scrollbar-track {
      background: transparent;
    }
    ::-webkit-scrollbar-thumb {
      background: rgba(120, 113, 108, 0.28);
      border-radius: 9999px;
    }

    /* Print Styles */
    @media print {
      body {
        background: white !important;
      }
      .no-print {
        display: none !important;
      }
      #paper-sheet {
        box-shadow: none !important;
        border: none !important;
        transform: none !important;
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 1in !important;
      }
    }
  </style>
</head>
<body class="min-h-screen flex flex-col justify-between text-stone-800 selection:bg-amber-200/70">

  <!-- Toast Notification Banner -->
  <div id="toast-banner" class="fixed top-5 left-1/2 -translate-x-1/2 z-50 pointer-events-none opacity-0 transition-all duration-300 translate-y-[-10px]">
    <div class="bg-stone-900/95 text-stone-50 backdrop-blur-md px-4 py-2 rounded-full text-xs font-medium shadow-xl flex items-center gap-2 border border-amber-500/30">
      <span id="toast-icon" class="text-amber-400">✦</span>
      <span id="toast-message">Saved to The Box</span>
    </div>
  </div>

  <!-- Top Navigation & Mechanical Rail Bar -->
  <header class="anim-header no-print relative z-20 w-full max-w-5xl mx-auto px-4 pt-4 pb-2 flex items-center justify-between gap-2">
    <!-- Left: The Box (Archive) & New Sheet -->
    <div class="flex items-center gap-2">
      <button id="btn-open-box" class="studio-pill flex items-center gap-2 px-3.5 py-2 rounded-full text-stone-700 text-xs font-medium group" title="Open The Box (Saved Letters)">
        <i data-lucide="archive" class="w-4 h-4 text-amber-700 group-hover:scale-110 transition-transform duration-200"></i>
        <span>The Box</span>
        <span id="box-count-badge" class="ml-0.5 px-1.5 py-0.2 bg-amber-800/15 text-amber-900 rounded-full text-[10px] font-semibold transition-transform group-hover:scale-110">1</span>
      </button>

      <button id="btn-new-note" class="studio-pill flex items-center gap-1.5 px-3.5 py-2 rounded-full text-stone-700 text-xs font-medium group" title="Insert Fresh Sheet">
        <i data-lucide="file-plus-2" class="w-4 h-4 text-amber-700 group-hover:rotate-6 transition-transform duration-200"></i>
        <span class="hidden sm:inline">New Sheet</span>
      </button>
    </div>

    <!-- Center: Brand & First Line Inspiration -->
    <div class="flex items-center gap-2">
      <span class="hidden md:inline-block font-typewriter-vintage text-sm tracking-wider text-stone-800 px-2 select-none">oLd tYP3</span>
      <button id="btn-first-line" class="studio-pill flex items-center gap-1.5 px-4 py-2 rounded-full text-stone-800 text-xs font-medium group" title="Insert Simple Quote or First Line">
        <i data-lucide="sparkles" class="w-3.5 h-3.5 text-amber-600 group-hover:rotate-45 group-hover:scale-110 transition-transform duration-300"></i>
        <span>First Line</span>
      </button>
    </div>

    <!-- Right: Sound & Export -->
    <div class="flex items-center gap-1.5 sm:gap-2">
      <button id="btn-toggle-sound" class="studio-pill p-2.5 rounded-full text-stone-700 group" title="Toggle Mechanical Sound">
        <i id="icon-sound" data-lucide="volume-2" class="w-4 h-4 group-hover:scale-110 transition-transform"></i>
      </button>

      <button id="btn-export-modal" class="flex items-center gap-1.5 px-4 py-2 rounded-full bg-gradient-to-b from-stone-800 to-stone-950 hover:from-stone-700 hover:to-stone-900 text-amber-50 border border-stone-600/50 shadow-md hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 active:scale-95 text-xs font-medium group">
        <i data-lucide="share" class="w-3.5 h-3.5 text-amber-300 group-hover:-translate-y-0.5 transition-transform"></i>
        <span class="hidden sm:inline">Export</span>
      </button>
    </div>
  </header>

  <!-- Main Typewriter Workspace -->
  <main class="relative z-10 flex-1 flex flex-col items-center justify-center px-3 sm:px-6 py-4 w-full max-w-4xl mx-auto">

    <!-- Precision Brushed-Brass Carriage Rail & Moving Capsule -->
    <div id="carriage-rail-container" class="anim-rail no-print w-full max-w-2xl mb-4 transition-all duration-300">
      <div class="relative h-10 flex items-center px-3">
        <!-- Metallic Carriage Rail Bar with Brass End Caps -->
        <div class="w-full h-2.5 rounded-full bg-gradient-to-b from-stone-300 via-stone-200 to-stone-400 shadow-inner border border-stone-500/40 relative flex items-center justify-between px-1">
          <!-- Left Spinning Ribbon Spool -->
          <span id="spool-left" class="w-4 h-4 -ml-2 rounded-full bg-gradient-to-tr from-stone-900 via-amber-700 to-amber-500 border border-amber-950 shadow flex items-center justify-center transition-transform duration-150">
            <span class="w-1 h-1 rounded-full bg-stone-200"></span>
          </span>
          <!-- Tick marks along rail -->
          <div class="w-full flex justify-between px-3 opacity-45">
            <span class="w-[1px] h-1.5 bg-stone-800"></span>
            <span class="w-[1px] h-1 bg-stone-800"></span>
            <span class="w-[1px] h-1.5 bg-stone-800"></span>
            <span class="w-[1px] h-1 bg-stone-800"></span>
            <span class="w-[1px] h-1.5 bg-stone-800"></span>
            <span class="w-[1px] h-1 bg-stone-800"></span>
            <span class="w-[1px] h-1.5 bg-stone-800"></span>
            <span class="w-[1px] h-1 bg-stone-800"></span>
            <span class="w-[1px] h-1.5 bg-stone-800"></span>
            <span class="w-[1px] h-1 bg-stone-800"></span>
            <span class="w-[1px] h-1.5 bg-stone-800"></span>
          </div>
          <!-- Right Spinning Ribbon Spool -->
          <span id="spool-right" class="w-4 h-4 -mr-2 rounded-full bg-gradient-to-tr from-stone-900 via-amber-700 to-amber-500 border border-amber-950 shadow flex items-center justify-center transition-transform duration-150">
            <span class="w-1 h-1 rounded-full bg-stone-200"></span>
          </span>
        </div>

        <!-- Moving Typewriter Capsule & Hanging Charm -->
        <div id="typewriter-capsule" class="absolute left-6 top-1/2 -translate-y-1/2 transition-all duration-150 ease-out flex flex-col items-center cursor-pointer select-none z-20 hover:scale-105" style="left: 8%;">
          <!-- Capsule Body -->
          <div class="px-3 py-1 rounded-full bg-gradient-to-b from-stone-800 via-stone-900 to-black text-amber-100 border border-amber-500/40 shadow-lg flex items-center gap-1.5 text-[10px] font-mono tracking-wider">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400 shadow-[0_0_6px_#fbbf24] animate-pulse"></span>
            <span id="capsule-col-indicator">001</span>
          </div>
          <!-- Mechanical Typebar Striker Arm (Flashes upward on keystroke) -->
          <div id="typebar-striker" class="w-1 h-4 bg-gradient-to-t from-stone-500 to-stone-200 rounded-t-sm opacity-0 pointer-events-none -mt-1"></div>
          <!-- Hanging 3D-style Charm -->
          <div id="hanging-charm" class="charm-sway -mt-2 text-xl drop-shadow-[0_4px_4px_rgba(0,0,0,0.35)] select-none" title="Your Typewriter Charm">
            🗝️
          </div>
        </div>
      </div>
    </div>

    <!-- Paper Sheet Surface -->
    <div id="paper-sheet" class="anim-paper-entrance paper-cream paper-curved relative w-full max-w-2xl min-h-[58vh] sm:min-h-[64vh] px-6 sm:px-14 py-10 sm:py-14 transition-all duration-500 flex flex-col justify-between border border-stone-300/60 overflow-hidden">

      <!-- Top Header inside Paper: Embossed Letterhead, Pressed Flower, & Date -->
      <div class="relative z-10 flex items-start justify-between gap-4 mb-6 select-none">
        <!-- Embossed Letterhead Mark -->
        <div id="letterhead-display" class="text-[11px] uppercase tracking-[0.24em] text-stone-400/90 font-serif border-b border-stone-300/50 pb-1 transition-all duration-300">
          FROM THE DESK OF oLd tYP3
        </div>

        <!-- Pressed Flower Bookmark & Photo Stamp Area -->
        <div class="flex items-center gap-3">
          <!-- Pressed Flower SVG -->
          <div id="pressed-flower-slot" class="transition-transform duration-300 hover:scale-125 hover:rotate-6 cursor-pointer" title="Click to cycle Pressed Flower">
            <!-- Rendered via JS -->
          </div>
        </div>
      </div>

      <!-- Optional Photo Stamp Attachment -->
      <div id="photo-stamp-container" class="hidden absolute z-20 top-20 right-8 rotate-2 hover:rotate-0 transition-shadow duration-200 bg-white p-2 pb-4 shadow-lg hover:shadow-xl border border-stone-200 group select-none cursor-grab active:cursor-grabbing touch-none" style="width: 148px;">
        <img id="photo-stamp-img" src="" alt="Attached Stamp" draggable="false" class="w-full aspect-[4/3] object-cover grayscale contrast-110 pointer-events-none" />
        <button id="btn-remove-photo" title="Remove Sticker" class="no-print absolute -top-2.5 -right-2.5 w-5 h-5 rounded-full bg-stone-800 text-white text-xs hidden group-hover:flex items-center justify-center shadow hover:scale-110 transition-transform cursor-pointer">×</button>
        <input
          type="text"
          id="photo-stamp-label"
          maxlength="28"
          placeholder="Memory Stamp"
          title="Click to edit photo stamp caption"
          class="font-vintage-cursive w-full bg-transparent border-none outline-none text-base leading-tight text-stone-700 focus:text-stone-950 text-center mt-1 tracking-normal placeholder:text-stone-300 cursor-text"
        />
        <!-- Bottom-Right Corner Resize Handle -->
        <div id="photo-stamp-resize" title="Drag to resize sticker" class="no-print absolute bottom-0.5 right-0.5 w-4 h-4 cursor-nwse-resize opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-end p-0.5 text-stone-400 hover:text-stone-800">
          <svg width="10" height="10" viewBox="0 0 10 10" fill="none"><path d="M9 1L1 9M9 5L5 9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"/></svg>
        </div>
      </div>

      <!-- Main Typing Area -->
      <textarea
        id="typewriter-editor"
        maxlength="3000"
        rows="10"
        wrap="soft"
        spellcheck="false"
        autocomplete="off"
        autocorrect="off"
        autocapitalize="off"
        placeholder="Strike a key to begin your letter..."
        class="relative z-10 w-full bg-transparent resize-none overflow-hidden break-words whitespace-pre-wrap border-none outline-none font-typewriter-vintage ink-black wear-fresh tracking-wide placeholder:text-stone-400/60 transition-colors duration-300"
      ></textarea>

      <!-- Paper Footer: Divider Tag, Date, Wax Seal & Character Meter (3,000 limit) -->
      <div class="relative z-10 mt-8 pt-3 border-t border-stone-300/40 flex flex-wrap items-center justify-between gap-2 text-[11px] font-mono text-stone-400 select-none">
        <div class="flex items-center gap-2">
          <span id="note-date-display">NOV 25, 2026</span>
          <span>•</span>
          <span id="note-divider-display" class="uppercase tracking-wider text-stone-500">Journal</span>
        </div>


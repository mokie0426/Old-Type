    // --- 3. SVG PRESSED FLOWERS & CHARMS ---
    const PRESSED_FLOWERS = {
      none: { label: 'None', svg: '<span class="text-[10px] text-stone-400 border border-dashed border-stone-300 px-2 py-0.5 rounded-full">+ Flower</span>' },

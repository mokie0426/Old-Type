    document.getElementById('btn-export-modal').addEventListener('click', () => {
      modalExport.classList.remove('hidden');
      modalExport.classList.add('flex');
    });

    document.getElementById('btn-close-export').addEventListener('click', () => {
      modalExport.classList.add('hidden');
      modalExport.classList.remove('flex');
    });

    // Save Aesthetic PNG Image with Aspect Ratio Framing
    document.getElementById('btn-export-image').addEventListener('click', async () => {
      modalExport.classList.add('hidden');
      modalExport.classList.remove('flex');
      showToast(`Developing ${selectedExportRatio === 'auto' ? 'original' : selectedExportRatio} paper image...`, '🖼️');
      try {
        const paperCanvas = await html2canvas(paperSheet, {
          scale: 2,
          backgroundColor: null,
          useCORS: true,
          onclone: (clonedDoc) => {
            const clonedPaper = clonedDoc.getElementById('paper-sheet');
            const clonedTextarea = clonedDoc.getElementById('typewriter-editor');
            const clonedPhotoInput = clonedDoc.getElementById('photo-stamp-label');

            if (clonedPaper) {
              clonedPaper.style.transform = 'none';
              clonedPaper.style.animation = 'none';
            }

            // Replace <textarea> with a wrapped <div> so html2canvas renders all lines & alignment accurately
            if (clonedTextarea) {
              const mirrorDiv = clonedDoc.createElement('div');
              mirrorDiv.className = clonedTextarea.className;
              const computed = window.getComputedStyle(editor);
              mirrorDiv.style.fontSize = computed.fontSize;
              mirrorDiv.style.lineHeight = computed.lineHeight;
              mirrorDiv.style.fontFamily = computed.fontFamily;
              mirrorDiv.style.letterSpacing = computed.letterSpacing;
              mirrorDiv.style.textAlign = computed.textAlign;
              mirrorDiv.style.color = computed.color;
              mirrorDiv.style.textShadow = computed.textShadow;
              mirrorDiv.style.opacity = computed.opacity;
              mirrorDiv.style.minHeight = computed.height;
              mirrorDiv.style.whiteSpace = 'pre-wrap';
              mirrorDiv.style.wordBreak = 'break-word';
              mirrorDiv.style.overflowWrap = 'break-word';
              mirrorDiv.textContent = editor.value || '';
              clonedTextarea.parentNode.replaceChild(mirrorDiv, clonedTextarea);
            }

            // Replace caption <input> on sticker with a centered <div> so caption never clips
            if (clonedPhotoInput) {
              const labelDiv = clonedDoc.createElement('div');
              labelDiv.className = clonedPhotoInput.className;
              labelDiv.textContent = photoLabelInput.value || '';
              clonedPhotoInput.parentNode.replaceChild(labelDiv, clonedPhotoInput);
            }
          }
        });

        let finalCanvas = paperCanvas;

        if (selectedExportRatio !== 'auto') {
          const [rw, rh] = selectedExportRatio.split(':').map(Number);
          const targetAspect = rw / rh;
          const padding = Math.round(Math.max(paperCanvas.width, paperCanvas.height) * 0.14);

          let outW = paperCanvas.width + padding * 2;
          let outH = paperCanvas.height + padding * 2;

          if (outW / outH > targetAspect) {
            outH = Math.round(outW / targetAspect);
          } else {
            outW = Math.round(outH * targetAspect);
          }

          finalCanvas = document.createElement('canvas');
          finalCanvas.width = outW;
          finalCanvas.height = outH;
          const ctx = finalCanvas.getContext('2d');

          // Warm studio desk mat gradient background
          const bgGrad = ctx.createRadialGradient(outW * 0.5, outH * 0.2, 20, outW * 0.5, outH * 0.5, Math.max(outW, outH) * 0.8);
          bgGrad.addColorStop(0, '#ebe5d9');
          bgGrad.addColorStop(1, '#cfc5b4');
          ctx.fillStyle = bgGrad;
          ctx.fillRect(0, 0, outW, outH);

          // Fit paper cleanly inside the chosen aspect ratio frame
          const maxPaperW = outW - padding * 1.4;
          const maxPaperH = outH - padding * 1.4;
          const scale = Math.min(1, maxPaperW / paperCanvas.width, maxPaperH / paperCanvas.height);
          const drawW = paperCanvas.width * scale;
          const drawH = paperCanvas.height * scale;
          const drawX = (outW - drawW) / 2;
          const drawY = (outH - drawH) / 2;

          ctx.save();
          ctx.shadowColor = 'rgba(28, 22, 15, 0.25)';
          ctx.shadowBlur = 36;
          ctx.shadowOffsetY = 16;
          ctx.drawImage(paperCanvas, drawX, drawY, drawW, drawH);
          ctx.restore();
        }

        const link = document.createElement('a');
        const suffix = selectedExportRatio === 'auto' ? 'original' : selectedExportRatio.replace(':', 'x');
        link.download = `old-typ3-letter-${suffix}-${Date.now()}.png`;
        link.href = finalCanvas.toDataURL('image/png');
        link.click();
        showToast('Image saved!', '✓');
      } catch (err) {
        showToast('Could not export image', '!');
      }
    });

    // Print / Save PDF
    document.getElementById('btn-export-print').addEventListener('click', () => {
      modalExport.classList.add('hidden');
      modalExport.classList.remove('flex');
      window.print();
    });

    // Copy Plain Text
    document.getElementById('btn-export-copy').addEventListener('click', () => {
      editor.select();
      document.execCommand('copy');
      window.getSelection().removeAllRanges();
      modalExport.classList.add('hidden');
      modalExport.classList.remove('flex');
      showToast('Letter copied to clipboard', '📋');
    });

    // Boot Application
    window.addEventListener('DOMContentLoaded', () => {
      loadState();
      renderCurrentNote();
      document.getElementById('box-count-badge').textContent = state.notes.length;
    });
  </script>
</body>
</html>
